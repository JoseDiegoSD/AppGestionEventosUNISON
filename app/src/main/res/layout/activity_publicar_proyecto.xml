<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Publicar proyecto"
            android:textColor="#17365D"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombreProyecto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Nombre del proyecto"
            android:inputType="textCapSentences"
            android:padding="14dp" />

        <EditText
            android:id="@+id/etDescripcionProyecto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="Descripción del proyecto"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="4"
            android:padding="14dp" />

        <EditText
            android:id="@+id/etResponsables"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Estudiantes responsables (separados por coma)"
            android:inputType="textCapWords|textMultiLine"
            android:padding="14dp" />

        <TextView
            android:id="@+id/tvFechaPublicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#666666"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnPublicar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#17365D"
            android:text="Publicar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>